@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HoursePhuMt[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HoursePhuMt[0].Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HoursePhuMt[0].DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HoursePhuMt[0].IsActive)
            </th>
