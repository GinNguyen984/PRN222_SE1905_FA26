@model RTMS.Entities.PhuocDH.Models.RacePhuocDh

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>RacePhuocDh</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RaceName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RaceName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PrizePool)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PrizePool)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RaceDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RaceDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsFinished)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsFinished)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="RacePhuocDhid" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <input id="btnDeleteBySignlR" type="button" value="Delete By SingalR" class="btn-success" />
        <a asp-action="Index">Back to List</a>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/microsoft/signalr/dist/browser/signalr.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/rthub")
        .build();
    connection.start().catch(err => console.error(err.toString()));
    document.getElementById("btnDeleteBySignlR").addEventListener("click", function (event) {
        const raceId = @Model.RacePhuocDhid;
        connection.invoke("HubDelete_RacePhuocDh", raceId)
            .then(() => window.location.href = "@Url.Action("Index")")
            .catch(err => console.error(err.toString()));
    });
</script>