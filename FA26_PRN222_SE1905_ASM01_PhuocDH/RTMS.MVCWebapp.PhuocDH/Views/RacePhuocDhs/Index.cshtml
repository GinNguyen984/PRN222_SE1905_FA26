@model IEnumerable<RTMS.Entities.PhuocDH.Models.RacePhuocDh>

@{
ViewData["Title"] = "Race Management";
}

<div class="container py-4">

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Race Management</h2>
        <p class="text-muted mb-0">
            Manage racing events and race information
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Create New Race
    </a>
</div>

<!-- Search Form -->
<form asp-action="Index" method="get">
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label">Race Name</label>
                <input type="text" id="RaceName" name="RaceName" class="form-control" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label">Prize Earned</label>
                <input type="number" id="PrizeEarned" name="PrizeEarned" class="form-control" step="0.01" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label">Finishing Position</label>
                <input type="number" id="FinishingPosition" name="FinishingPosition" class="form-control" />
            </div>
        </div>
        <div class="col-md-3 mt-4">
            <div class="form-group">
                <input type="submit" value="Search" class="btn btn-sm btn-primary" />
                <a asp-action="Create" class="btn btn-sm btn-success">Create New</a>
            </div>
        </div>
    </div>
</form>

<!-- Table Card -->
<div class="card shadow-sm border-0">

    <div class="card-header bg-primary text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Race List</h5>

            <span id="raceCount" class="badge bg-light text-primary">
                @Model.Count() races
            </span>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive" id="tableRTMS">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">
                            @Html.DisplayNameFor(model => model.RaceName)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.PrizePool)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.RaceDate)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.IsFinished)
                        </th>

                        <th>
                            Finishing Position
                        </th>

                        <th class="text-end pe-4">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody id="raceTBodyId">
                    @foreach (var item in Model)
                    {
                        <tr id="@item.RacePhuocDhid"> 

                            <td class="ps-4">
                                <div class="fw-semibold">
                                    @Html.DisplayFor(modelItem => item.RaceName)
                                </div>

                                <small class="text-muted">
                                    Race #@item.RacePhuocDhid
                                </small>
                            </td>

                            <td>
                                <span class="fw-semibold text-success">
                                    @Html.DisplayFor(modelItem => item.PrizePool)
                                </span>
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.RaceDate)
                            </td>

                            <td>
                                @if (item.IsFinished == true)
                                {
                                    <span class="badge bg-success">
                                        Finished
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Upcoming
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.RaceResultPhuocDhs != null && item.RaceResultPhuocDhs.Any())
                                {
                                    @foreach (var result in item.RaceResultPhuocDhs)
                                    {
                                        <span class="badge bg-info text-dark me-1">
                                            @result.FinishingPosition
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>

                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">

                                    <a asp-action="Details"
                                       asp-route-id="@item.RacePhuocDhid"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.RacePhuocDhid"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.RacePhuocDhid"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>


        </div>

    </div>
</div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/lib/table-pagination.js"></script>
<script>
    //tableRTMS
    $('#tableRTMS').createTablePagination();
    $('#tableRTMS').createTablePagination({
    rowPerPage: 10,
    paginationColor:'#6f7ad7',
    fontColor:'#555555',
    paginationStyle:'borderless',// or 'bordered'
  });

</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/rthub")
        .build();
    connection.on("Receiver_Delete_RacePhuocDh", function (raceId) {
        $("#raceTBodyId").find(`tr[id='${raceId}']`).remove();
        $("#raceCount").text($("#raceTBodyId tr").length + " races");
        $('#tableRTMS').createTablePagination({
            rowPerPage: 10,
            paginationColor: '#6f7ad7',
            fontColor: '#555555',
            paginationStyle: 'borderless'
        });
    });
    connection.start().catch(err => console.error(err.toString()));
</script>