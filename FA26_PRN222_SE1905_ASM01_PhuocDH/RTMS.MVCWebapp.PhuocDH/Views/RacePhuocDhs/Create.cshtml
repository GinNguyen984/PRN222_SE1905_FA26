@model RTMS.Entities.PhuocDH.Models.RacePhuocDh

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>RacePhuocDh</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RaceName" class="control-label"></label>
                <input asp-for="RaceName" class="form-control />
                <span asp-validation-for="RaceName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrizePool" class="control-label"></label>
                <input asp-for="PrizePool" class="form-control" />
                <span asp-validation-for="PrizePool" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RaceDate" class="control-label"></label>
                <input asp-for="RaceDate" class="form-control" readonly />
                <span asp-validation-for="RaceDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsFinished" class="control-label"></label>
                <input asp-for="IsFinished" class="form-control" readonly />
                <span asp-validation-for="IsFinished" class="text-danger" ></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <input type="button" id="btnCreateBySignalR" value="Create by SignalR" class="btn btn-success"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

