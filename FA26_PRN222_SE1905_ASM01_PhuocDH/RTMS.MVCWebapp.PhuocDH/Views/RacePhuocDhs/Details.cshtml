@model RTMS.Entities.PhuocDH.Models.RacePhuocDh

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>RacePhuocDh</h4>
    <hr />
    <dl class="row" id="raceId">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RaceName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RaceName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PrizePool)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PrizePool)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RaceDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RaceDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsFinished)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsFinished)
        </dd>
    </dl>
</div>

<div class="mt-4">
    <h4>Race Results</h4>
    <hr />
    @if (Model.RaceResultPhuocDhs != null && Model.RaceResultPhuocDhs.Any())
    {
        <table class="table table-striped table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Result ID</th>
                    <th>Hourse ID</th>
                    <th>Registration Date</th>
                    <th>Finishing Position</th>
                    <th>Prize Earned</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model.RaceResultPhuocDhs)
                {
                    <tr>
                        <td>@result.RaceResultPhuocDhid</td>
                        <td>@result.HourseId</td>
                        <td>@result.RegistrationDate</td>
                        <td>@result.FinishingPosition</td>
                        <td>@result.PrizeEarned</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No race results available.</p>
    }
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.RacePhuocDhid">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/rthub")
        .build();

    connection.start().catch(err => console.error(err.toString()));

    connection.on("Receiver_Delete_RacePhuocDh", function (raceId) {
        document.getElementById("raceId").innerHTML = "This item was deleted";
    });
</script>