@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg modern-navbar sticky-top mb-4">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-dark text-decoration-none" href="">
                    <span class="fs-4">🏇</span>
                    <span>RTMS Track</span>
                    <span class="navbar-brand-badge">PhuMT</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                                <i class="bi bi-house-door me-1"></i> Home
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="hoursephumts">
                                <i class="bi bi-trophy me-1"></i> Horse Management
                            </NavLink>
                        </li>
                    </ul>

                    <!-- Right Controls: Theme Selector Dropdown -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill px-3 py-1 d-flex align-items-center gap-2" type="button" id="themeDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-palette2"></i>
                                <span id="currentThemeLabel">Theme</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" aria-labelledby="themeDropdownBtn">
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" onclick="setAppTheme('slate')">
                                        <span class="badge rounded-circle p-1" style="background-color: #3b82f6;">&nbsp;</span>
                                        <span>💎 Modern Slate (Default)</span>
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" onclick="setAppTheme('turf')">
                                        <span class="badge rounded-circle p-1" style="background-color: #10b981;">&nbsp;</span>
                                        <span>🌿 Emerald Turf (Equestrian)</span>
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" onclick="setAppTheme('royal')">
                                        <span class="badge rounded-circle p-1" style="background-color: #8b5cf6;">&nbsp;</span>
                                        <span>👑 Royal Purple</span>
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" onclick="setAppTheme('midnight')">
                                        <span class="badge rounded-circle p-1" style="background-color: #0f172a;">&nbsp;</span>
                                        <span>🌙 Midnight Cyber (Dark)</span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 flex-grow-1">
        <main role="main" class="pb-4">
            @Body
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container-fluid px-lg-4 d-flex align-items-center justify-content-between small">
            <span>&copy; 2026 - <strong>RTMS Track System</strong> &bull; Blazor Interactive &bull; Developed by PhuMT</span>
            <span class="badge bg-light text-secondary border">Interactive Server Mode</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
