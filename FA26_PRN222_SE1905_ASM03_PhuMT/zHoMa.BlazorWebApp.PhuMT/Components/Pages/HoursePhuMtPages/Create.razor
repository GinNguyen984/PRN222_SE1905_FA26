@page "/hoursephumts/create"
@rendermode InteractiveServer
@using zHoMa.Entities.PhuMT.Models
@using zHoMa.Services.PhuMT.Interface

@inject IHoursePhuMtService HoursePhuMtService
@inject NavigationManager NavigationManager

<PageTitle>Register New Horse - RTMS PhuMT</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="" class="text-decoration-none">
                    <i class="bi bi-house-door"></i> Home
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="hoursephumts" class="text-decoration-none">Horse Management</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Register Horse</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="form-card shadow-lg">
                <!-- Header -->
                <div class="form-card-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white bg-opacity-25 p-3 d-flex align-items-center justify-content-center text-white" style="width: 52px; height: 52px; font-size: 1.5rem;">
                            🏇
                        </div>
                        <div>
                            <h3 class="fw-bold mb-1 text-white">Register New Horse</h3>
                            <p class="mb-0 text-white text-opacity-75 small">Complete the form below to add a new racing horse to the official registry.</p>
                        </div>
                    </div>
                </div>

                <!-- Form Body -->
                <div class="p-4 p-md-5">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>@errorMessage</div>
                        </div>
                    }

                    <EditForm Model="HoursePhuMt" OnValidSubmit="HandleCreateAsync">
                        <DataAnnotationsValidator />

                        <!-- Section 1: Basic Info -->
                        <div class="form-section-title">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>Basic Identification</span>
                        </div>

                        <!-- Horse Name -->
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold text-secondary small">
                                Horse Name <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                <InputText id="name" @bind-Value="HoursePhuMt.Name" class="form-control" placeholder="e.g. Thunder Blaze, Secretariat" />
                            </div>
                            <ValidationMessage For="() => HoursePhuMt.Name" class="text-danger small mt-1" />
                        </div>

                        <!-- Pedigree / Bloodline -->
                        <div class="mb-4">
                            <label for="pedigree" class="form-label fw-semibold text-secondary small">
                                Pedigree / Bloodline
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-diagram-3"></i></span>
                                <InputText id="pedigree" @bind-Value="HoursePhuMt.Pedigree" class="form-control" placeholder="e.g. Thoroughbred, Arabian, Quarter Horse" list="pedigreeOptions" />
                            </div>
                            <datalist id="pedigreeOptions">
                                <option value="Thoroughbred" />
                                <option value="Arabian" />
                                <option value="Quarter Horse" />
                                <option value="Standardbred" />
                                <option value="Appaloosa" />
                                <option value="Morgan" />
                            </datalist>
                            <div class="form-text small">Enter breed lineage or sire & dam pedigree records.</div>
                            <ValidationMessage For="() => HoursePhuMt.Pedigree" class="text-danger small mt-1" />
                        </div>

                        <!-- Section 2: Physical Metrics -->
                        <div class="form-section-title">
                            <i class="bi bi-speedometer2 text-primary"></i>
                            <span>Physical Metrics & Attributes</span>
                        </div>

                        <div class="row g-3 mb-4">
                            <!-- Weight -->
                            <div class="col-md-6">
                                <label for="weight" class="form-label fw-semibold text-secondary small">
                                    Weight (kg)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-speedometer2"></i></span>
                                    <InputNumber id="weight" @bind-Value="HoursePhuMt.Weight" class="form-control" placeholder="e.g. 520.50" step="0.01" />
                                    <span class="input-group-text">kg</span>
                                </div>
                                <ValidationMessage For="() => HoursePhuMt.Weight" class="text-danger small mt-1" />
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-6">
                                <label for="dateofbirth" class="form-label fw-semibold text-secondary small">
                                    Date of Birth
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                                    <InputDate id="dateofbirth" @bind-Value="HoursePhuMt.DateOfBirth" class="form-control" />
                                </div>
                                <ValidationMessage For="() => HoursePhuMt.DateOfBirth" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <!-- Section 3: Status -->
                        <div class="form-section-title">
                            <i class="bi bi-shield-check text-primary"></i>
                            <span>Status & Racing Eligibility</span>
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <div class="form-check form-switch mb-1">
                                <input class="form-check-input" type="checkbox" role="switch" id="isactiveSwitch" 
                                       checked="@(HoursePhuMt.IsActive == true)" 
                                       @onchange="e => HoursePhuMt.IsActive = (bool)(e.Value ?? false)" />
                                <label class="form-check-label fw-semibold text-dark" for="isactiveSwitch">
                                    Active for Racing Competitions
                                </label>
                            </div>
                            <small class="text-muted d-block ps-1">
                                @(HoursePhuMt.IsActive == true ? "🟢 Currently eligible and cleared for tournament tracks." : "⚪ Horse is resting, quarantined, or retired.")
                            </small>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <a href="hoursephumts" class="btn btn-light px-4 py-2 rounded-pill fw-semibold border d-inline-flex align-items-center gap-2">
                                <i class="bi bi-arrow-left"></i>
                                <span>Cancel & Return</span>
                            </a>
                            <button type="submit" class="btn btn-primary-gradient px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Registering...</span>
                                }
                                else
                                {
                                    <i class="bi bi-plus-lg"></i>
                                    <span>Register Horse</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HoursePhuMt HoursePhuMt = new()
    {
        IsActive = true,
        DateOfBirth = DateOnly.FromDateTime(DateTime.Today.AddYears(-3))
    };

    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task HandleCreateAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await HoursePhuMtService.Create(HoursePhuMt);
            if (result != null)
            {
                NavigationManager.NavigateTo("hoursephumts");
            }
            else
            {
                errorMessage = "Failed to register horse. Please verify your data and try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating horse: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
