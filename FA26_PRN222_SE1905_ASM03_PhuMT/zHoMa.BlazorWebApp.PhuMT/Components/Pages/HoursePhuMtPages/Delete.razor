@page "/hoursephumts/delete"
@rendermode InteractiveServer
@using zHoMa.Entities.PhuMT.Models
@using zHoMa.Services.PhuMT.Interface

@inject IHoursePhuMtService HoursePhuMtService
@inject NavigationManager NavigationManager

<PageTitle>Delete @(hoursephumt?.Name ?? "Horse") - RTMS PhuMT</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="" class="text-decoration-none">
                    <i class="bi bi-house-door"></i> Home
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="hoursephumts" class="text-decoration-none">Horse Management</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Delete Confirmation</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            @if (isLoading)
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <div class="spinner-border text-danger mx-auto mb-3" role="status"></div>
                    <h5 class="fw-bold text-dark">Loading horse record...</h5>
                </div>
            }
            else if (hoursephumt is null)
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <div class="fs-1 text-danger mb-3">⚠️</div>
                    <h5 class="fw-bold text-dark">Horse Record Not Found</h5>
                    <p class="text-muted small mb-3">No record found with ID #@HoursePhuMtid.</p>
                    <a href="hoursephumts" class="btn btn-primary rounded-pill px-4">Back to Registry</a>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                    <!-- Warning Header -->
                    <div class="p-4 bg-danger text-white text-center">
                        <div class="rounded-circle bg-white text-danger d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 60px; height: 60px; font-size: 1.8rem;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Delete Horse Record</h4>
                        <p class="mb-0 text-white-50 small">Are you sure you want to permanently remove this horse from the registry?</p>
                    </div>

                    <!-- Horse Profile Preview -->
                    <div class="card-body p-4 p-md-5">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <div>@errorMessage</div>
                            </div>
                        }

                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 bg-white p-3 border text-center font-monospace" style="min-width: 60px;">
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">ID</small>
                                    <span class="fw-bold fs-5 text-dark">#@hoursephumt.HoursePhuMtid.ToString("D2")</span>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-1 text-dark">@hoursephumt.Name</h4>
                                    <div class="text-muted small">
                                        <i class="bi bi-diagram-3 me-1"></i>@(string.IsNullOrWhiteSpace(hoursephumt.Pedigree) ? "Unspecified bloodline" : hoursephumt.Pedigree)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Data list -->
                        <div class="list-group list-group-flush mb-4 small">
                            <div class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Weight:</span>
                                <span class="fw-semibold text-dark">@(hoursephumt.Weight.HasValue ? $"{hoursephumt.Weight.Value:N2} kg" : "--")</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Date of Birth:</span>
                                <span class="fw-semibold text-dark">@(hoursephumt.DateOfBirth.HasValue ? hoursephumt.DateOfBirth.Value.ToString("dd MMM yyyy") : "--")</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Status:</span>
                                <span>
                                    @if (hoursephumt.IsActive == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Inactive</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <!-- Confirmation Button -->
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <a href="hoursephumts" class="btn btn-light px-4 py-2 rounded-pill fw-semibold border d-inline-flex align-items-center gap-2">
                                <i class="bi bi-arrow-left"></i>
                                <span>Cancel & Return</span>
                            </a>
                            <button type="button" @onclick="HandleDeleteAsync" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Deleting...</span>
                                }
                                else
                                {
                                    <i class="bi bi-trash3-fill"></i>
                                    <span>Delete Horse Permanently</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private int HoursePhuMtid { get; set; }

    private HoursePhuMt? hoursephumt;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            hoursephumt = await HoursePhuMtService.GetByIdAsync(HoursePhuMtid);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading horse: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDeleteAsync()
    {
        if (hoursephumt is null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await HoursePhuMtService.Delete(hoursephumt.HoursePhuMtid);
            if (result)
            {
                NavigationManager.NavigateTo("hoursephumts");
            }
            else
            {
                errorMessage = "Failed to delete horse record. It might be referenced by other records or already removed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting horse: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
