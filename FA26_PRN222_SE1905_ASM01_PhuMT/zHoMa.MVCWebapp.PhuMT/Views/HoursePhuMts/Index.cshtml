@model IEnumerable<zHoMa.Entities.PhuMT.Models.HoursePhuMt>

@{
    ViewData["Title"] = "Horse Roster & Management";

    var totalHorses = Model?.Count() ?? 0;
    var activeHorses = Model?.Count(h => h.IsActive == true) ?? 0;
    var inactiveHorses = totalHorses - activeHorses;
    var avgWeight = (Model != null && Model.Any(h => h.Weight.HasValue))
        ? Model.Where(h => h.Weight.HasValue).Average(h => h.Weight!.Value)
        : 0m;
}

<!-- Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    /* Metric Cards */
    .metric-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .metric-icon-box {
        width: 50px;
        height: 50px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    /* Table Container */
    .table-card {
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.06);
        background: #ffffff;
        overflow: hidden;
    }

    .custom-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

    .custom-table thead th {
        background-color: #f8fafc;
        color: #475569;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        padding: 1rem 1.25rem;
        border-bottom: 2px solid #e2e8f0;
        white-space: nowrap;
    }

    .custom-table tbody tr {
        transition: background-color 0.15s ease-in-out;
        border-bottom: 1px solid #f1f5f9;
    }

    .custom-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .custom-table td {
        padding: 1.1rem 1.25rem;
        color: #334155;
    }

    /* Avatar Badge */
    .horse-avatar {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
        color: #3730a3;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    /* Action Buttons */
    .btn-action {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        transition: all 0.15s ease;
    }

    .btn-action:hover {
        transform: scale(1.08);
    }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
        transition: all 0.2s ease;
    }

    .btn-primary-gradient:hover {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.4);
        color: #ffffff;
    }

    .search-input-group .input-group-text {
        background-color: #f8fafc;
        border-color: #cbd5e1;
        color: #64748b;
    }

    .status-pulse {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 6px;
    }

    .status-pulse.active {
        background-color: #10b981;
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    }

    .status-pulse.inactive {
        background-color: #94a3b8;
    }
</style>

<div class="container-fluid px-lg-4 py-4">
    <!-- Top Bar: Title & Primary CTA -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Horse Management</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <span>🏇 Horse Roster & Registry</span>
            </h2>
            <p class="text-muted small mb-0">Manage profile data, bloodlines, physical conditions, and race eligibility.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-action="Create" class="btn btn-primary-gradient px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg fs-6"></i>
                <span>Register New Horse</span>
            </a>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Account" asp-action="Logout" class="btn btn-primary-gradient px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2">
                <i class="bi bi-box-arrow-right fs-6"></i>
                <span>Logout</span>
            </a>
        </div>
    </div>

    <!-- Metric / KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Horses (Primary) -->
        <div class="col-sm-6 col-xl-3">
            <div class="card metric-card bg-primary text-white p-3 border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white text-opacity-75 small fw-semibold text-uppercase">Total Horses</span>
                        <h3 class="fw-bold mb-0 mt-1 text-white">@totalHorses</h3>
                        <small class="text-white text-opacity-75">Registered in registry</small>
                    </div>
                    <div class="metric-icon-box bg-white bg-opacity-25 text-white">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Horses (Success) -->
        <div class="col-sm-6 col-xl-3">
            <div class="card metric-card bg-success text-white p-3 border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white text-opacity-75 small fw-semibold text-uppercase">Active & Ready</span>
                        <h3 class="fw-bold mb-0 mt-1 text-white">@activeHorses</h3>
                        <small class="text-white small fw-medium">
                            <i class="bi bi-check-circle me-1"></i>Eligible for racing
                        </small>
                    </div>
                    <div class="metric-icon-box bg-white bg-opacity-25 text-white">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inactive Horses (Danger) -->
        <div class="col-sm-6 col-xl-3">
            <div class="card metric-card bg-danger text-white p-3 border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white text-opacity-75 small fw-semibold text-uppercase">Resting / Inactive</span>
                        <h3 class="fw-bold mb-0 mt-1 text-white">@inactiveHorses</h3>
                        <small class="text-white text-opacity-75 small">Medical leave / retired</small>
                    </div>
                    <div class="metric-icon-box bg-white bg-opacity-25 text-white">
                        <i class="bi bi-pause-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Average Weight (Info) -->
        <div class="col-sm-6 col-xl-3">
            <div class="card metric-card bg-info text-white p-3 border-0 shadow-sm rounded-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white text-opacity-75 small fw-semibold text-uppercase">Average Weight</span>
                        <h3 class="fw-bold mb-0 mt-1 text-white">@avgWeight.ToString("N1") <span class="fs-6 fw-normal text-white text-opacity-75">kg</span></h3>
                        <small class="text-white text-opacity-75 small">Physical condition avg</small>
                    </div>
                    <div class="metric-icon-box bg-white bg-opacity-25 text-white">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Filter Form (Template) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 bg-white" style="padding-bottom: 2rem !important;">
        <form asp-action="Index" method="get" id="searchFilterForm">
            <div class="row align-items-start g-3">
                <div class="col-md-2">
                    <div class="form-group position-relative mb-0">
                        <label class="control-label fw-semibold text-secondary small mb-1">Code (ID)</label>
                        <input type="text" id="Code" name="Code" value="@ViewData["Code"]" class="form-control @(ViewBag.CodeError != null ? "is-invalid" : "")" placeholder="Search ID..." />
                        <span id="codeError" class="text-danger small position-absolute" style="top: 100%; left: 0; margin-top: 4px; font-size: 0.75rem; font-weight: 500; white-space: nowrap; z-index: 10; display: @(ViewBag.CodeError != null ? "block" : "none");">
                            <i class="bi bi-exclamation-circle me-1"></i>@(ViewBag.CodeError ?? "Mã ID chỉ được nhập số!")
                        </span>
                        @* <select id="BankId" name="Code" class="form-control" asp-items="ViewBag.Code"></select> *@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group mb-0">
                        <label class="control-label fw-semibold text-secondary small mb-1">Name</label>
                        <input type="text" id="Name" name="Name" value="@ViewData["Name"]" class="form-control" placeholder="Search Name..." />
                        @* <select id="BankId" name="Name" class="form-control" asp-items="ViewBag.Name"></select> *@
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-0">
                        <label class="control-label fw-semibold text-secondary small mb-1">Weight (kg)</label>
                        <div class="input-group">
                            <select name="WeightOp" class="form-select" style="max-width: 140px;">
                                <option value=">=" selected="@(ViewData["WeightOp"]?.ToString() == ">=")">Lớn hơn (>=)</option>
                                <option value="<=" selected="@(ViewData["WeightOp"]?.ToString() == "<=")">Nhỏ hơn (<=)</option>
                                <option value=">"  selected="@(ViewData["WeightOp"]?.ToString() == ">")">Lớn hẳn (>)</option>
                                <option value="<"  selected="@(ViewData["WeightOp"]?.ToString() == "<")">Nhỏ hẳn (<)</option>
                                <option value="="  selected="@(ViewData["WeightOp"]?.ToString() == "=")">Bằng (=)</option>
                            </select>
                            <input type="number" step="0.01" id="Weight" name="Weight" value="@ViewData["Weight"]" class="form-control" placeholder="Số cân..." />
                        </div>
                        @* <select id="BankId" name="Weight" class="form-control" asp-items="ViewBag.Weight"></select> *@
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group mb-0">
                        <label class="control-label small mb-1 d-none d-md-block opacity-0 user-select-none" style="visibility: hidden;">Action</label>
                        <div class="d-flex align-items-center gap-2 flex-wrap flex-md-nowrap">
                            <button type="submit" class="btn btn-primary px-3 fw-semibold d-inline-flex align-items-center">
                                <i class="bi bi-search me-1"></i>Search
                            </button>
                            <a asp-action="Create" class="btn btn-success px-3 fw-semibold d-inline-flex align-items-center">
                                <i class="bi bi-plus-lg me-1"></i>Create New
                            </a>
                            @if (!string.IsNullOrEmpty(ViewData["Code"]?.ToString()) || !string.IsNullOrEmpty(ViewData["Name"]?.ToString()) || !string.IsNullOrEmpty(ViewData["Weight"]?.ToString()))
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center" title="Reset filter">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Main Table Card -->
        <!-- Filter & Search Toolbar -->
        <div class="p-3 p-md-4 border-bottom bg-white">
            <div class="row g-3 align-items-center justify-content-between">
                <!-- Search Box -->
                <div class="col-md-5 col-lg-4">
                    <div class="input-group search-input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="horseSearchInput" class="form-control bg-light border-start-0 ps-0" placeholder="Search by name, pedigree..." autocomplete="off" />
                        <button class="btn btn-light border border-start-0 text-muted" type="button" id="clearSearchBtn" style="display:none;" title="Clear search">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>
                </div>

                <!-- Filters & Controls -->
                <div class="col-md-7 col-lg-8">
                    <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                        <!-- Status Filter -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted fw-semibold">Status:</span>
                            <select id="statusFilter" class="form-select form-select-sm" style="width: auto;">
                                <option value="all">All Statuses (@totalHorses)</option>
                                <option value="active">Active (@activeHorses)</option>
                                <option value="inactive">Inactive (@inactiveHorses)</option>
                            </select>
                        </div>

                        <!-- Counter Badge -->
                        <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                            Showing <span id="visibleCount" class="fw-bold text-dark">@totalHorses</span> of @totalHorses horses
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Responsive -->
        <div class="table-responsive" id="RTMSTable">
            <table class="table custom-table" id="horseTable">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Horse Profile</th>
                        <th>Pedigree & Bloodline</th>
                        <th>Weight</th>
                        <th>Date of Birth</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                @* cai bang bao doi *@
                <tbody id="horseTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var isActive = item.IsActive == true;
                            var initial = !string.IsNullOrWhiteSpace(item.Name) ? item.Name.Substring(0, 1).ToUpper() : "H";
                            var age = item.DateOfBirth.HasValue
                                ? (DateTime.Now.Year - item.DateOfBirth.Value.Year)
                                : 0;

                            <tr class="horse-row" 
                                id="@item.HoursePhuMtid"
                                data-name="@(item.Name?.ToLower() ?? "")" 
                                data-pedigree="@(item.Pedigree?.ToLower() ?? "")" 
                                data-status="@(isActive ? "active" : "inactive")">
                                <!-- ID -->
                                <td>
                                    <span class="badge bg-light text-muted border font-monospace">#@item.HoursePhuMtid.ToString("D2")</span>
                                </td>

                                <!-- Horse Profile -->
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="horse-avatar">
                                            @initial
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@item.HoursePhuMtid" class="fw-bold text-decoration-none text-dark hover-primary d-block">
                                                @item.Name
                                            </a>
                                            <small class="text-muted font-monospace">ID: @item.HoursePhuMtid</small>
                                        </div>
                                    </div>
                                </td>

                                <!-- Pedigree / Bloodline -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Pedigree))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-diagram-3 text-primary opacity-75"></i>
                                            <span class="fw-medium text-dark">@item.Pedigree</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Unspecified bloodline</span>
                                    }
                                </td>

                                <!-- Weight -->
                                <td>
                                    @if (item.Weight.HasValue)
                                    {
                                        <div class="d-flex align-items-baseline gap-1">
                                            <span class="fw-bold text-dark">@item.Weight.Value.ToString("N2")</span>
                                            <span class="text-muted small">kg</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>

                                <!-- Date of Birth & Age -->
                                <td>
                                    @if (item.DateOfBirth.HasValue)
                                    {
                                        <div class="text-dark fw-medium">
                                            <i class="bi bi-calendar-event me-1 text-muted small"></i>
                                            @item.DateOfBirth.Value.ToString("dd MMM yyyy")
                                        </div>
                                        @if (age > 0)
                                        {
                                            <small class="text-muted">(@age yrs old)</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>

                                <!-- Status Badge -->
                                <td>
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center">
                                            <span class="status-pulse active"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center">
                                            <span class="status-pulse inactive"></span> Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="text-end">
                                    <div class="btn-group gap-1" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.HoursePhuMtid" class="btn btn-action btn-outline-primary" title="Edit Horse">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.HoursePhuMtid" class="btn btn-action btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.HoursePhuMtid" class="btn btn-action btn-outline-danger" title="Delete Horse">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="py-4">
                                    <div class="fs-1 text-muted mb-3">🐎</div>
                                    <h5 class="fw-bold text-dark">No horses registered yet</h5>
                                    <p class="text-muted small mb-3">Get started by creating your first horse profile in the registry.</p>
                                    <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-plus-lg me-1"></i> Register New Horse
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    <!-- Zero results placeholder for client filter -->
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="7" class="text-center py-5">
                            <div class="py-4">
                                <i class="bi bi-search fs-1 text-muted mb-2 d-block"></i>
                                <h6 class="fw-bold text-dark mb-1">No matching horses found</h6>
                                <p class="text-muted small mb-3">Try adjusting your search terms or status filter.</p>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" id="resetFiltersBtn">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Table Pagination Toolbar (Limited to 5 items per page) -->
        <div class="p-3 border-top bg-white d-flex flex-column flex-md-row align-items-center justify-content-between gap-3" id="tablePaginationWrapper">
            <div class="small text-muted" id="tablePaginationInfo">
                Showing <span class="fw-semibold text-dark" id="pageStartItem">1</span> to <span class="fw-semibold text-dark" id="pageEndItem">5</span> of <span class="fw-semibold text-dark" id="pageTotalItems">@totalHorses</span> horses
            </div>
            <nav aria-label="Horse table pagination">
                <ul class="pagination pagination-sm mb-0 gap-1" id="tablePaginationUl">
                    <!-- Pagination buttons rendered by JS -->
                </ul>
            </nav>
        </div>

        <!-- Table Footer -->
        <div class="p-3 border-top bg-light bg-opacity-50 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 small text-muted">
            <div>
                <i class="bi bi-info-circle me-1"></i> Click on any horse name or view icon for full medical and training history.
            </div>
            <div>
                <span>Race Track Management System &bull; <strong>RTMS</strong></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('horseSearchInput');
            const clearSearchBtn = document.getElementById('clearSearchBtn');
            const statusFilter = document.getElementById('statusFilter');
            const visibleCount = document.getElementById('visibleCount');
            const rows = Array.from(document.querySelectorAll('.horse-row'));
            const noResultsRow = document.getElementById('noResultsRow');
            const resetFiltersBtn = document.getElementById('resetFiltersBtn');

            // 5 items per page configuration
            const PAGE_SIZE = 5;
            let currentPage = 1;

            function updateTableDisplay() {
                const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
                const selectedStatus = statusFilter ? statusFilter.value : 'all';

                // Show/hide clear button
                if (clearSearchBtn) {
                    clearSearchBtn.style.display = (query.length > 0) ? 'block' : 'none';
                }

                // 1. Filter rows matching search & status
                const matchingRows = [];
                rows.forEach(row => {
                    const name = row.getAttribute('data-name') || '';
                    const pedigree = row.getAttribute('data-pedigree') || '';
                    const status = row.getAttribute('data-status') || '';

                    const matchesQuery = !query || name.includes(query) || pedigree.includes(query);
                    const matchesStatus = (selectedStatus === 'all') || (status === selectedStatus);

                    if (matchesQuery && matchesStatus) {
                        matchingRows.push(row);
                    } else {
                        row.style.display = 'none';
                    }
                });

                const totalMatching = matchingRows.length;
                const totalPages = Math.ceil(totalMatching / PAGE_SIZE) || 1;

                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                // 2. Pagination: display only 5 items for the current page
                const startIndex = (currentPage - 1) * PAGE_SIZE;
                const endIndex = Math.min(startIndex + PAGE_SIZE, totalMatching);

                matchingRows.forEach((row, idx) => {
                    if (idx >= startIndex && idx < endIndex) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });

                // 3. Update counter badges & summary text
                if (visibleCount) {
                    visibleCount.textContent = totalMatching;
                }

                if (noResultsRow) {
                    noResultsRow.style.display = (totalMatching === 0 && rows.length > 0) ? '' : 'none';
                }

                const pageStartItem = document.getElementById('pageStartItem');
                const pageEndItem = document.getElementById('pageEndItem');
                const pageTotalItems = document.getElementById('pageTotalItems');
                const paginationWrapper = document.getElementById('tablePaginationWrapper');

                if (pageStartItem && pageEndItem && pageTotalItems) {
                    pageStartItem.textContent = totalMatching === 0 ? 0 : startIndex + 1;
                    pageEndItem.textContent = endIndex;
                    pageTotalItems.textContent = totalMatching;
                }

                if (paginationWrapper) {
                    paginationWrapper.style.display = (totalMatching === 0) ? 'none' : 'flex';
                }

                // 4. Render Bootstrap pagination buttons
                renderPagination(totalPages);
            }

            function renderPagination(totalPages) {
                const ul = document.getElementById('tablePaginationUl');
                if (!ul) return;
                ul.innerHTML = '';

                if (totalPages <= 1) {
                    return;
                }

                // Previous Button
                const prevLi = document.createElement('li');
                prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
                prevLi.innerHTML = `<button class="page-link shadow-none rounded-2" type="button" aria-label="Previous"><i class="bi bi-chevron-left"></i></button>`;
                if (currentPage > 1) {
                    prevLi.addEventListener('click', function (e) {
                        e.preventDefault();
                        currentPage--;
                        updateTableDisplay();
                    });
                }
                ul.appendChild(prevLi);

                // Page Number Buttons
                for (let p = 1; p <= totalPages; p++) {
                    const pageLi = document.createElement('li');
                    pageLi.className = `page-item ${p === currentPage ? 'active' : ''}`;
                    pageLi.innerHTML = `<button class="page-link shadow-none rounded-2 fw-semibold" type="button">${p}</button>`;
                    const targetPage = p;
                    pageLi.addEventListener('click', function (e) {
                        e.preventDefault();
                        if (currentPage !== targetPage) {
                            currentPage = targetPage;
                            updateTableDisplay();
                        }
                    });
                    ul.appendChild(pageLi);
                }

                // Next Button
                const nextLi = document.createElement('li');
                nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
                nextLi.innerHTML = `<button class="page-link shadow-none rounded-2" type="button" aria-label="Next"><i class="bi bi-chevron-right"></i></button>`;
                if (currentPage < totalPages) {
                    nextLi.addEventListener('click', function (e) {
                        e.preventDefault();
                        currentPage++;
                        updateTableDisplay();
                    });
                }
                ul.appendChild(nextLi);
            }

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentPage = 1;
                    updateTableDisplay();
                });
            }

            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function () {
                    searchInput.value = '';
                    currentPage = 1;
                    updateTableDisplay();
                    searchInput.focus();
                });
            }

            if (statusFilter) {
                statusFilter.addEventListener('change', function() {
                    currentPage = 1;
                    updateTableDisplay();
                });
            }

            if (resetFiltersBtn) {
                resetFiltersBtn.addEventListener('click', function () {
                    if (searchInput) searchInput.value = '';
                    if (statusFilter) statusFilter.value = 'all';
                    currentPage = 1;
                    updateTableDisplay();
                });
            }

            // Real-time & Submit Validation for Code (ID)
            const codeInput = document.getElementById('Code');
            const codeError = document.getElementById('codeError');
            const searchFilterForm = document.getElementById('searchFilterForm');

            function validateCode() {
                if (!codeInput) return true;
                const val = codeInput.value.trim();
                if (val !== '' && !/^\d+$/.test(val)) {
                    codeInput.classList.add('is-invalid');
                    if (codeError) {
                        codeError.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Mã ID chỉ được nhập số!';
                        codeError.style.display = 'block';
                    }
                    return false;
                } else {
                    codeInput.classList.remove('is-invalid');
                    if (codeError) {
                        codeError.innerHTML = '';
                        codeError.style.display = 'none';
                    }
                    return true;
                }
            }

            if (codeInput) {
                codeInput.addEventListener('input', validateCode);
            }

            if (searchFilterForm) {
                searchFilterForm.addEventListener('submit', function (e) {
                    if (!validateCode()) {
                        e.preventDefault();
                        codeInput.focus();
                    }
                });
            }

            // Initial display with pagination
            updateTableDisplay();
        });
    </script>
    <script src="~/lib/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/RTMSHub")
            .withAutomaticReconnect()
            .build();

        connection.on("Receiver_Delete", function (id) {
            console.log("Real-time delete received for horse #", id);
            window.location.reload();
        });

        connection.on("Receiver_Create", function (id) {
            console.log("Real-time new horse registered #", id);
            window.location.reload();
        });

        connection.on("Receiver_Update", function (id) {
            console.log("Real-time horse updated #", id);
            window.location.reload();
        });

        connection.start()
            .then(function () {
                console.log("Connected to /RTMSHub successfully");
            })
            .catch(err => console.error("SignalR Connection Error: ", err.toString()));
    </script>
}
