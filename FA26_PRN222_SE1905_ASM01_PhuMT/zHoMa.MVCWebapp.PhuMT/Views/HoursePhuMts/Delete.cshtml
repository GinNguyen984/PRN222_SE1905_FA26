@model zHoMa.Entities.PhuMT.Models.HoursePhuMt

@{
    ViewData["Title"] = $"Delete {Model?.Name ?? "Horse"}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                    <i class="bi bi-house-door"></i> Home
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index" class="text-decoration-none">Horse Management</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Delete Confirmation</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <!-- Warning Header -->
                <div class="p-4 bg-danger text-white text-center">
                    <div class="rounded-circle bg-white text-danger d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 60px; height: 60px; font-size: 1.8rem;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Delete Horse Record</h4>
                    <p class="mb-0 text-white-50 small">Are you sure you want to permanently remove this horse from the registry?</p>
                </div>

                <!-- Horse Profile Preview -->
                <div class="card-body p-4 p-md-5">
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-white p-3 border text-center font-monospace" style="min-width: 60px;">
                                <small class="text-muted d-block" style="font-size: 0.7rem;">ID</small>
                                <span class="fw-bold fs-5 text-dark">#@Model?.HoursePhuMtid.ToString("D2")</span>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1 text-dark">@Model?.Name</h4>
                                <div class="text-muted small">
                                    <i class="bi bi-diagram-3 me-1"></i>@(string.IsNullOrWhiteSpace(Model?.Pedigree) ? "Unspecified bloodline" : Model.Pedigree)
                                </div>
                            </div>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush mb-4 small">
                        <li class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted">Weight:</span>
                            <span class="fw-bold text-dark">@(Model?.Weight.HasValue == true ? Model.Weight.Value.ToString("N2") + " kg" : "--")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted">Date of Birth:</span>
                            <span class="fw-bold text-dark">@(Model?.DateOfBirth.HasValue == true ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "--")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted">Status:</span>
                            <span class="fw-bold @(Model?.IsActive == true ? "text-success" : "text-secondary")">
                                @(Model?.IsActive == true ? "Active" : "Inactive")
                            </span>
                        </li>
                    </ul>

                    <div class="alert alert-warning d-flex align-items-center gap-2 small rounded-3" role="alert">
                        <i class="bi bi-info-circle-fill fs-5 text-warning flex-shrink-0"></i>
                        <div>
                            This action cannot be undone. Associated training plans or health logs may be affected.
                        </div>
                    </div>

                    <!-- Confirmation Form -->
                    <form asp-action="Delete" asp-route-id="@Model.HoursePhuMtid" method="post" id="deleteForm" class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.HoursePhuMtid" />
                        <input type="hidden" asp-for="HoursePhuMtid" />
                        <input type="button" value="Delete" class="btn btn-success" onclick="document.getElementById('deleteForm').submit();" />
                        <input type="button" id="btnDeleteBySignalR" value="Delete by SignalR" class="btn btn-success" />

                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-trash3-fill me-1"></i> Confirm Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/RTMSHub")
            .withAutomaticReconnect()
            .build();

        connection.start().then(function () {
            console.log("Connected to /RTMSHub successfully");
        }).catch(err => console.error("Error connecting to /RTMSHub:", err.toString()));

        // Listen for Receiver_Delete broadcast
        connection.on("Receiver_Delete", function (id) {
            if (id == @Model.HoursePhuMtid) {
                window.location.href = '@Url.Action("Index", "HoursePhuMts")';
            }
        });

        // 1. Regular Delete button click
        const btnDelete = document.querySelector('input[value="Delete"]');
        if (btnDelete) {
            btnDelete.addEventListener("click", function () {
                document.getElementById("deleteForm").submit();
            });
        }

        // 2. Delete by SignalR button click
        const btnSignalR = document.getElementById("btnDeleteBySignalR");
        if (btnSignalR) {
            btnSignalR.addEventListener("click", function (event) {
                event.preventDefault();
                const id = parseInt('@Model.HoursePhuMtid');

                function triggerSignalRDelete() {
                    connection.invoke("HubDelete_IHoursePhuMt", id)
                        .then(function () {
                            window.location.href = '@Url.Action("Index", "HoursePhuMts")';
                        })
                        .catch(function (err) {
                            console.error("SignalR delete error:", err);
                            document.getElementById("deleteForm").submit();
                        });
                }

                if (connection.state === signalR.HubConnectionState.Connected) {
                    triggerSignalRDelete();
                } else {
                    connection.start().then(triggerSignalRDelete).catch(function () {
                        document.getElementById("deleteForm").submit();
                    });
                }
            });
        }
    </script>
}
                            